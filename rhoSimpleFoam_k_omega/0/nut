FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 5e-6;

boundaryField
{
    inlet
    {
      type             inletOutlet;
      inletValue       $internalField;
    }

    outlet
    {
      type              zeroGradient;
    }

    side
    {
        type            empty;
    }

    ".*Wall"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    
    vane
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}


