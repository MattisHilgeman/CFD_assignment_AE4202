FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Uinlet          (100 0 0);

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinlet;

boundaryField
{
    inlet
    {
        type            inletOutlet;
        inletValue      $internalField;
    }

    ".*Wall"
    {
        type            noSlip;
    }
    vane
    {
        type            noSlip;
    }
    
    outlet
    {
        type            zeroGradient;
    }

    side
    {
        type            empty;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}


