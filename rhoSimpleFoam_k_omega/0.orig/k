FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

kInlet          0.01;

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 787.6; 

boundaryField
{
    inlet
    {
      type             turbulentIntensityKineticEnergyInlet; 
      intensity	       0.06;
      value            $internalField;
    }

    outlet
    {
      type              zeroGradient;
    }


    side
    {
        type            empty;
    }

    ".*Wall"
    {
        type            cyclicAMI;
    }
    
    vane
    {
        type            kqRWallFunction;
        value           0.;
    }    
    #includeEtc "caseDicts/setConstraintTypes"
}

    


