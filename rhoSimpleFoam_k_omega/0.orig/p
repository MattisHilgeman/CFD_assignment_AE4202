FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pOut            1e5;

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pOut;

boundaryField
{
    inlet 
    {
      type             inletOutlet;
      inletValue         $internalField;
    }

    outlet
    {
      type              zeroGradient;
    }

    side
    {
        type            empty;
    }

    ".*Wall" 
    {
        type            zeroGradient;
    }
    
    vane 
    {
        type            zeroGradient;
    }
    

    #includeEtc "caseDicts/setConstraintTypes"
}


