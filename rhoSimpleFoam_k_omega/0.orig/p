FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pOut            1e5;

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pOut;

boundaryField
{
    inlet 
    {
        type            totalPressure;
//	psi		psi;
	gamma		1.4;
	p0		uniform 330860;
    }

    outlet
    {
        type		fixedValue;
	value		uniform 154960;
    }

    side
    {
        type            empty;
    }

    ".*Wall" 
    {
        type            cyclicAMI;
    }
    
    vane 
    {
        type            zeroGradient;
    }
    

    #includeEtc "caseDicts/setConstraintTypes"
}



