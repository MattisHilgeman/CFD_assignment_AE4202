FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Tinlet          300;

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $Tinlet;

boundaryField
{
    inlet
    {
        type            totalTemperature;
	T0		uniform 420;
	gamma		1.4;
	
    }

    outlet
    {
        type            zeroGradient;
    }

    side
    {
        type            empty;
    }

    ".*Wall"
    {
        type            cyclicAMI;
    }

    vane
    {
        type            fixedValue;
	value		uniform 300; 
    }

    #includeEtc "caseDicts/setConstraintTypes"
}


